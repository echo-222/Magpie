{
  "magpie_pack": {
    "id": "pack_e8cea12f13",
    "name": "为手工陶器小品牌制定 Instagram 的视觉方向与文案语气，传达安静、有手感、接受不完美的品牌气质。",
    "created_at": "2026-09-17T10:47:46+00:00",
    "updated_at": "2026-09-17T10:47:46+00:00",
    "task": {
      "raw_request": "给一个手工陶器小品牌做 Instagram 的视觉方向和文案语气：安静、有手感、接受不完美，不要网红滤镜和营销腔。",
      "purpose": "为手工陶器小品牌制定 Instagram 的视觉方向与文案语气，传达安静、有手感、接受不完美的品牌气质。",
      "desired_qualities": [
        "安静",
        "有手感/肌理感",
        "接受不完美",
        "朴素自然",
        "真诚不营销",
        "温度感"
      ],
      "avoid": [
        "网红滤镜",
        "营销腔",
        "过度精致/虚假完美"
      ],
      "constraints": [
        "平台为 Instagram",
        "品牌为手工陶器小品牌",
        "需同时涵盖视觉方向与文案语气"
      ],
      "needed_reference_types": [
        "材质/质感",
        "色彩/色调",
        "氛围/场景",
        "文案语气",
        "版式/字体"
      ],
      "search_queries": [
        "手作陶器肌理 自然光静物",
        "wabi-sabi ceramics muted earthy tones",
        "calm minimal Instagram pottery layout",
        "诚实朴素文案 手工品牌语气",
        "不完美手作陶器 细节"
      ],
      "language": "zh"
    },
    "human_direction": "视觉上走安静、低饱和、触及材料真实肌理的方向：多用手作器物特写、自然底纹和大面积留白，强调不对称、修复痕迹和时间带来的表面变化；构图保持单一焦点或灰调安静场景。文案上采用减法表达，少修饰、不喊口号，把“不完美”说成自然的一部分，避免网红滤镜和营销腔。",
