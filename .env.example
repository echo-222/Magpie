# Copy to .env and adjust. Never commit .env.
#
# Magpie talks to models through ONE small OpenAI-compatible adapter (magpie/llm.py).
# Default = fully local via Ollama (no API key needed):
#   ollama pull qwen3:8b qwen2.5vl:7b bge-m3
#
# Any OpenAI-compatible provider works (OpenAI, DeepSeek, Qwen/DashScope, Moonshot,
# OpenRouter, ...): change base URL / key / model names.

# provider: "openai" (any OpenAI-compatible endpoint, incl. Ollama) | "fake" (offline tests)
MAGPIE_LLM_PROVIDER=openai
MAGPIE_LLM_BASE_URL=http://localhost:11434/v1
MAGPIE_LLM_API_KEY=ollama

# chat model: task understanding, text analysis, recomposition reasoning
MAGPIE_CHAT_MODEL=qwen3:8b
# vision model: image description / style keywords / visible text
MAGPIE_VISION_MODEL=qwen2.5vl:7b

# embeddings (may point at a different provider than chat, e.g. chat on DeepSeek, embed on Ollama)
MAGPIE_EMBED_MODEL=bge-m3
# MAGPIE_EMBED_BASE_URL=http://localhost:11434/v1
# MAGPIE_EMBED_API_KEY=ollama

# OCR: auto (use rapidocr if installed, else vision-model visible_text) | off
MAGPIE_OCR=auto

# where the SQLite db + stored files live
MAGPIE_DATA_DIR=./data

# --- example: OpenAI cloud ---
# MAGPIE_LLM_BASE_URL=https://api.openai.com/v1
# MAGPIE_LLM_API_KEY=sk-...
# MAGPIE_CHAT_MODEL=gpt-4.1-mini
# MAGPIE_VISION_MODEL=gpt-4.1-mini
# MAGPIE_EMBED_MODEL=text-embedding-3-small
