# Copy to .env and adjust. Never commit .env (it is .gitignore'd).
#
# Magpie talks to models through ONE small OpenAI-compatible adapter (magpie/llm.py) with three
# roles. Switching the chat role between local Qwen and DeepSeek is one line: MAGPIE_CHAT_PROVIDER.
#
#   chat   : task understanding, text analysis, recomposition, roles/reasons, alternatives
#   vision : image description / style keywords (stays local; images never go to the chat provider)
#   embed  : embeddings for retrieval (stays local)

# "openai" = any OpenAI-compatible endpoint (Ollama, DeepSeek, OpenAI, ...) | "fake" = offline tests
MAGPIE_LLM_PROVIDER=openai

# ---------------------------------------------------------------- chat provider switch
# local    -> the MAGPIE_LLM_* endpoint (Ollama by default) + MAGPIE_CHAT_MODEL  (no key, ~1-2.5 min per pack)
# deepseek -> DeepSeek API: DEEPSEEK_* below                                     (fast, better reasoning)
MAGPIE_CHAT_PROVIDER=deepseek

# --- DeepSeek (used when MAGPIE_CHAT_PROVIDER=deepseek) ---
# key from https://platform.deepseek.com  — the only value you must fill in
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-v4-pro = strongest (thinking on by default); deepseek-flash = cheaper/faster
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro
# thinking: off = ~20-30 s per pack (default here); on = deeper reasoning but ~2-3 min per pack; unset = provider default (on for v4-pro)
DEEPSEEK_THINKING=off
# if the DeepSeek call fails (network / auth / 5xx), retry that call once on the local chat model
MAGPIE_CHAT_FALLBACK_TO_LOCAL=true

# ---------------------------------------------------------------- local Ollama
# scripts/setup_ollama_models.sh pulls qwen3:8b, qwen2.5vl:7b, bge-m3 and creates qwen3:8b-16k
MAGPIE_LLM_BASE_URL=http://localhost:11434/v1
MAGPIE_LLM_API_KEY=ollama
# local chat model (MAGPIE_CHAT_PROVIDER=local, and the fallback). qwen3:8b-16k = qwen3:8b with a 16k
# context; Ollama's 4096 default truncates the recomposition prompt.
MAGPIE_CHAT_MODEL=qwen3:8b-16k
# vision model: image description / style keywords / visible text
MAGPIE_VISION_MODEL=qwen2.5vl:7b
# embeddings (may point at another endpoint via MAGPIE_EMBED_BASE_URL / MAGPIE_EMBED_API_KEY)
MAGPIE_EMBED_MODEL=bge-m3
# MAGPIE_EMBED_BASE_URL=http://localhost:11434/v1
# MAGPIE_EMBED_API_KEY=ollama

# ---------------------------------------------------------------- misc
# OCR: auto (use rapidocr if installed, else vision-model visible_text) | off
MAGPIE_OCR=auto
# where the SQLite db + stored files live
MAGPIE_DATA_DIR=./data
# per-call timeout in seconds (local 7-8B models can take 1-2 min for recomposition)
MAGPIE_LLM_TIMEOUT=180

# ---------------------------------------------------------------- example: everything on OpenAI
# MAGPIE_CHAT_PROVIDER=local
# MAGPIE_LLM_BASE_URL=https://api.openai.com/v1
# MAGPIE_LLM_API_KEY=sk-...
# MAGPIE_CHAT_MODEL=gpt-4.1-mini
# MAGPIE_VISION_MODEL=gpt-4.1-mini
# MAGPIE_EMBED_MODEL=text-embedding-3-small
